# Copy to .env.local and fill in your Hugging Face token.
# Create a fine-grained token with "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens

#HF_TOKEN=
# Alias also accepted:
# HUGGINGFACE_API_KEY=

# Optional overrides
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# HUGGINGFACE_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest

# API that hosts /mcp (defaults to NEXT_PUBLIC_API_URL / localhost:5236)
# NEXT_PUBLIC_API_URL=http://localhost:5236
# MCP_SERVER_URL=http://localhost:5236
